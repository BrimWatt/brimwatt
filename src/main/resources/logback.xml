<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Third-party libraries (Jetty, Javalin): warnings and errors only -->
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Our own code: INFO and above (DEBUG lines hidden) -->
    <logger name="com.example" level="INFO"/>
</configuration>
